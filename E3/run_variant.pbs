#!/bin/bash
#PBS -N abl_variant
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=04:00:00
#PBS -j oe

# =============================================================================
# Plan-Components Ablation (Chapter 5.4): run ONE variant for the 14B model.
#
# Submit one variant at a time. Pass VARIANT (and optionally MODEL) via qsub:
#   cd <code dir>            # MUST submit from the dir holding the .py files
#   qsub -v MODEL=14B,VARIANT=V0 run_variant.pbs
#   qsub -v MODEL=14B,VARIANT=V1 run_variant.pbs
#   ... V2, V3, V4
# Defaults to MODEL=14B if unset.
#
# Logs: each variant writes its OWN log to  logs/abl_<MODEL>_<VARIANT>.log
#       (handled INSIDE the script, so you never get clashing logs even if you
#        forget to pass qsub -o). The PBS spooled .log can be ignored.
#
# Optional flags:
#   OVERWRITE=1   force rerun even if the raw CSV already exists
#   LIMIT=8       smoke test on the first 8 rows only
#   e.g. qsub -v MODEL=14B,VARIANT=V0,LIMIT=8 run_variant.pbs
# =============================================================================

set -e

MODEL="${MODEL:-14B}"
VARIANT="${VARIANT:?Set VARIANT, e.g. qsub -v MODEL=14B,VARIANT=V0 run_variant.pbs}"

# --- per-variant log: redirect everything below into its own file -----------
cd "$PBS_O_WORKDIR"
mkdir -p logs
LOGFILE="logs/abl_${MODEL}_${VARIANT}.log"
exec > "$LOGFILE" 2>&1     # from here on, all stdout/stderr -> the variant log

echo "=== Ablation 5.4 — model: $MODEL  variant: $VARIANT ==="
echo "Started: $(date)  Host: $(hostname)  Job: $PBS_JOBID"
nvidia-smi || echo "nvidia-smi unavailable"

# --- environment (your llama_eval setup) ---
source ~/miniconda3/etc/profile.d/conda.sh
conda activate llama_eval
export CUDA_VISIBLE_DEVICES=0

# Single-GPU: avoid Ray miscounting the node's GPUs. The code forces the mp
# backend for tp=1, and these make multiprocessing well-behaved on a shared node.
export VLLM_WORKER_MULTIPROC_METHOD=spawn

# Offline model loading (CX3 compute nodes have no internet). Ensure the
# Qwen2.5-14B-Instruct weights are on disk and config.py's model_path points at
# them (or set HF_HOME to the cache holding them).
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# export HF_HOME=$HOME/m4r_project/hf_cache    # EDIT if your cache is elsewhere
export TOKENIZERS_PARALLELISM=false

echo "WD: $(pwd)  Python: $(which python)  MODEL=$MODEL VARIANT=$VARIANT  LOG=$LOGFILE"

# --- optional flags ---
EXTRA=""
[ "${OVERWRITE:-0}" = "1" ] && EXTRA="$EXTRA --overwrite"
[ -n "${LIMIT:-}" ] && EXTRA="$EXTRA --limit $LIMIT"

# --- run inference for exactly this one (model, variant) ---
echo "--- RUN ABLATION: $MODEL / $VARIANT ---"
python run_ablation.py --model "$MODEL" --variants "$VARIANT" $EXTRA

echo "Finished: $(date)"
echo "Output: see config.py OUTPUT_DIR -> raw/${MODEL}_${VARIANT}_raw.csv"
