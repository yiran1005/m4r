#!/bin/bash
###############################################################################
# run_qwen_plan.pbs
# Rerun Qwen2.5-72B plan-and-solve generation on the ~295 failed (NaN) rows.
#
# 用法:
#   1. 先 export 你的 API key 到 shell, 或写在 ~/.bashrc 里:
#        export DASHSCOPE_API_KEY=sk-xxx
#   2. 把改进后的 qwen_api_inference.py 与已部分完成的 CSV 放在工作目录下:
#        ~/m4r_project/Model Answer/Origin Answer/qwen2.5_72b_PS_AE_check.csv
#   3. 提交:
#        qsub run_qwen_plan.pbs
#
###############################################################################

#PBS -N qwen72b_plan_rerun
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o qwen72b_plan_rerun.log

# 邮件通知 (可选, 取消注释并填入你的邮箱)
##PBS -m abe
##PBS -M yx3422@ic.ac.uk

set -e
cd $PBS_O_WORKDIR

echo "[i] Job started on $(hostname) at $(date)"
echo "[i] PBS_O_WORKDIR = $PBS_O_WORKDIR"

# --------------------- 环境激活 ---------------------

source /rds/general/user/yx3422/home/miniconda3/etc/profile.d/conda.sh
conda activate llama_eval
export DASHSCOPE_API_KEY="sk-ce07c64c3e1e48cd8b83a9ad25c0d0c3"
# --------------------- API key 检查 ---------------------
if [ -z "$DASHSCOPE_API_KEY" ]; then
    echo "[X] DASHSCOPE_API_KEY is empty. Set it in ~/.bashrc or before qsub."
    exit 1
fi
echo "[i] DASHSCOPE_API_KEY length = ${#DASHSCOPE_API_KEY} (sanity check)"

# --------------------- 跑 ---------------------
# 改进版脚本自动续跑:已存在的 output CSV 会被识别, 只重跑 NaN 行
python qwen_evaluation_72b_2.py \
    --dataset_name mini-StatQA \
    --output_name qwen2.5 \
    --trick PS_AE_check

echo "[i] Job finished at $(date)"
