#!/bin/bash
#PBS -N exp1_part2_main
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o exp1_part2_main.log

# =============================================================================
# Submit:        qsub run_inference.pbs
# Resume:        qsub run_inference.pbs again — auto-skips done pairs
# Live log:      tail -f exp1_part2_main.log
#
# Workflow inside this job:
#   1. Dry-run (no GPU work)
#   2. Smoke test: 2 questions × 27 methods = 54 queries (~5-10 min on L40S)
#   3. Sanity check parse error rate on the smoke test
#   4. If parse error rate ≤ 20% → continue with the remaining 48 questions
#      If parse error rate >  20% → abort and print diagnostics
#
# Resumability: run_inference.py keys on (question_id, method) and appends to
# the same JSONL, so the smoke test's 54 records are NOT re-run in step 4.
# =============================================================================

set -e

echo "======================================"
echo "Exp 1 Part 2: Instance Judgement (MAIN)"
echo "Model: Qwen2.5-14B-Instruct"
echo "======================================"
echo "Job started:  $(date)"
echo "Host:         $(hostname)"
nvidia-smi || echo "nvidia-smi unavailable"
echo "--------------------------------------"

# 1. Activate conda environment
source ~/miniconda3/etc/profile.d/conda.sh
conda activate llama_eval

# 2. Single GPU
export CUDA_VISIBLE_DEVICES=0

# 3. Move to submit directory
cd "$PBS_O_WORKDIR"
echo "Working directory: $(pwd)"
echo "Python:            $(which python)"
echo "--------------------------------------"

# 4. Dry-run — verify imports, paths, prompt construction (no model loaded yet)
echo "==== STEP 1/4: DRY RUN ===="
python run_inference.py --dry-run

# 5. Smoke test — run only the first 2 questions (54 queries, ~5-10 min)
echo
echo "==== STEP 2/4: SMOKE TEST (2 questions) ===="
python run_inference.py --limit-q 2

# 6. Parse the smoke-test outputs and check parse error rate
echo
echo "==== STEP 3/4: PARSE ERROR RATE CHECK ===="
python parse_outputs.py

# Use a small Python one-liner to read the rate and fail the job if it is high.
# Threshold: 20%. Below this we proceed with the full run; above we abort so
# you can inspect failing responses before burning hours of GPU time.
PARSE_ERROR_RATE=$(python -c "
import json, sys
n_total, n_err = 0, 0
with open('outputs_correct/parsed_judgements.jsonl') as f:
    for line in f:
        line = line.strip()
        if not line: continue
        r = json.loads(line)
        n_total += 1
        if r['verdict'] == 'PARSE_ERROR':
            n_err += 1
rate = (n_err / n_total * 100) if n_total else 100.0
print(f'{rate:.1f}')
")

echo "Smoke-test parse error rate: ${PARSE_ERROR_RATE}%"

# Bash cannot do float comparison directly; pipe through awk for the decision.
PROCEED=$(awk -v rate="$PARSE_ERROR_RATE" 'BEGIN { print (rate <= 20.0) ? "yes" : "no" }')

if [ "$PROCEED" != "yes" ]; then
    echo
    echo "######################################"
    echo "ABORTING: parse error rate ${PARSE_ERROR_RATE}% > 20%."
    echo "######################################"
    echo "Inspect failing responses with:"
    echo "  grep '\"verdict\": \"PARSE_ERROR\"' outputs/parsed_judgements.jsonl | head -3"
    echo
    echo "Two ways forward:"
    echo "  (a) Adjust parse_outputs.py regex patterns, then resubmit."
    echo "      The 54 smoke-test records will be reused (resumable)."
    echo "  (b) If the model's responses look fundamentally off, inspect"
    echo "      outputs/raw_judgements.jsonl and adjust prompts.py."
    echo "      That requires deleting outputs/raw_judgements.jsonl before"
    echo "      resubmitting, because the old responses would otherwise be"
    echo "      kept."
    echo
    echo "Job finished (aborted): $(date)"
    exit 1
fi

echo "Parse error rate OK. Proceeding to full run."

# 7. Full run — resumes automatically, skips the 54 smoke-test records
echo
echo "==== STEP 4/4: FULL RUN (remaining 48 questions) ===="
python run_inference.py

# 8. Re-parse the full output so the final parsed JSONL contains all 1350
echo
echo "==== POST-PROCESSING: Re-parsing full output ===="
python parse_outputs.py

echo "======================================"
echo "Job finished: $(date)"
echo "======================================"
