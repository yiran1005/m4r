#!/bin/bash
#PBS -N exp2_condA_turn2
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o exp2_condA_turn2.log

# =============================================================================
# Turn 2: Selection Conditioned on Summary.
# PREREQUISITE: run_turn1.pbs finished AND parse_turn1.py produced
#               outputs/turn1_parsed.jsonl.
# Submit:   qsub run_turn2.pbs
# Resume:   resubmit — skips done question_ids.
#
# Walltime 1.5h: 50 questions x up to 512 tokens. Usually ~10-20 min + load.
# =============================================================================

set -e
echo "=== Exp 2 Cond A — Turn 2 ==="
echo "Started: $(date)  Host: $(hostname)"
nvidia-smi || echo "nvidia-smi unavailable"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate llama_eval
export CUDA_VISIBLE_DEVICES=0
cd "$PBS_O_WORKDIR"
echo "WD: $(pwd)  Python: $(which python)"

echo "--- DRY RUN ---"
python run_turn2.py --dry-run

echo "--- REAL RUN ---"
python run_turn2.py

echo "--- COMPUTE METRICS (CPU) ---"
python compute_metrics.py

echo "Finished: $(date)"
