#!/bin/bash
#PBS -N exp2_condC
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o exp2_condC.log

# =============================================================================
# Cond C: Oracle Summary. Runs on 14B / 72B / 7B.
#
# Select the model by passing MODEL_KEY as a qsub variable:
#   qsub -v MODEL_KEY=14b run_turn2.pbs
#   qsub -v MODEL_KEY=72b run_turn2.pbs
#   qsub -v MODEL_KEY=7b  run_turn2.pbs
# Defaults to 14b if unset.
#
# NOTE: 72B does NOT fit on a single 48GB L40S in bf16 (~144GB needed). For
# 72B, request multiple GPUs, e.g.:
#   #PBS -l select=1:ncpus=16:mem=200gb:ngpus=4:gpu_type=L40S
# and submit a 72B-specific copy of this script. device_map="auto" will shard.
#
# Outputs are namespaced as outputs_<model_key>/ so the three runs coexist.
# =============================================================================

set -e
echo "=== Exp 2 Cond C (Oracle) — model: ${MODEL_KEY:-14b} ==="
echo "Started: $(date)  Host: $(hostname)"
nvidia-smi || echo "nvidia-smi unavailable"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate llama_eval
export CUDA_VISIBLE_DEVICES=0
export MODEL_KEY="${MODEL_KEY:-14b}"     # propagate to config.py
cd "$PBS_O_WORKDIR"
echo "WD: $(pwd)  Python: $(which python)  MODEL_KEY=$MODEL_KEY"

# 1. Build the oracle verdict tables (CPU, instant, no model).
echo "--- CONSTRUCT ORACLE ---"
python construct_oracle.py

# 2. Dry-run Turn 2 (verify the oracle table renders correctly).
echo "--- TURN 2 DRY RUN ---"
python run_turn2.py --dry-run

# 3. Real Turn 2 inference.
echo "--- TURN 2 REAL RUN ---"
python run_turn2.py

# 4. Metrics (CPU).
echo "--- COMPUTE METRICS ---"
python compute_metrics.py

echo "Finished: $(date)"
